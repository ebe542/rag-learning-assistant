# Automatically distinguish text files from binary files. New text-based file
# types use LF unless a platform-specific rule below explicitly overrides it.
* text=auto eol=lf

# Keep source and configuration files consistent across operating systems.
.gitattributes text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
