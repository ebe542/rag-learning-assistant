# Python virtual environments
.venv/
venv/
env/

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]

# Test, lint, and coverage artifacts
.pytest_cache/
# Milestone and diagnostic runs use named base-temp directories. Windows may
# keep them locked briefly, but none of their contents belong in Git or Ruff.
.pytest-*/
.ruff_cache/
.coverage
htmlcov/

# Build and packaging artifacts
build/
dist/
release-dist/
*.egg-info/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Editor-specific workspace settings
.idea/
.vscode/

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local source documents
# PDFs may contain copyrighted or private learning material.
*.pdf

# The synthetic benchmark fixture is original project material and intentionally
# versioned so performance measurements have a stable, redistributable input.
!benchmarks/fixtures/summarization-document.pdf

# Local test documents, generated indices, and application data
# Everything in this directory must remain reproducible.
local-data/
