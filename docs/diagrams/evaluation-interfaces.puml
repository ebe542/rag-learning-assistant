@startuml
title Evaluation and Interface Boundaries
!include _theme.puml
left to right direction

package "generation" #FFF4D9 {
  class GroundedAnswer <<immutable model>>
}
package "evaluation" #EFFFF4 {
  class ExpectedCitation <<immutable model>>
  class ExpectedConcept <<immutable model>>
  class GroundedEvaluationCase <<immutable model>>
  class GroundedEvaluationResult <<immutable model>>
  class GroundedEvaluationReport <<immutable model>>
  class GroundedGenerationEvaluator
}
package "interfaces.cli" #F2F2F2 {
  interface SubcommandCollection <<Protocol>>
  class "parser.build_parser" as CliParser <<function>>
  class "entrypoint.main" as CliEntrypoint <<function>>
  class "commands" as CliCommands <<module>>
  class "doctor" as Doctor <<module>>
  class "error_reporting" as ErrorReporting <<module>>
}
package "interfaces.web" #E8F4FD {
  interface PackageCatalog <<Protocol>>
  interface SummaryCatalog <<Protocol>>
  interface QuestionCatalog <<Protocol>>
  interface PackageStudy <<Protocol>>
  interface ProgressReporting <<Protocol>>
  interface LibraryManagement <<Protocol>>
  class LocalLibraryManager
  class "application.create_app" as WebApplication <<function>>
  class "server.run_server" as WebServer <<function>>
  class "base.html" as BaseTemplate <<template>>
  class "home.html" as HomeTemplate <<template>>
  class "library_detail.html" as LibraryDetailTemplate <<template>>
  class "library_management.html" as LibraryManagementTemplate <<template>>
  class "package_create.html" as PackageCreateTemplate <<template>>
  class "package_upload_validated.html" as PackageUploadValidatedTemplate <<template>>
  class "progress.html" as ProgressTemplate <<template>>
}
package "application services" #FFE8E8 {
  class LibraryService
  class QuestionAnsweringService
  class DocumentSummarizationService
  class DocumentSummaryCatalog
  class QuestionBankService
  class QuestionBankCatalog
  class LearningPackageService
  class LearningPackageCatalog
  class LearningPackageStudyService
  class LearningProgressService
}
package "learning adapter" #F3E8FF {
  class SqliteLearningPackageRepository
}

GroundedEvaluationCase *-- "1..*" ExpectedCitation
GroundedEvaluationCase *-- "0..*" ExpectedConcept
GroundedEvaluationResult o-- "0..*" ExpectedCitation
GroundedEvaluationReport *-- "1..*" GroundedEvaluationResult
GroundedGenerationEvaluator --> GroundedEvaluationCase
GroundedGenerationEvaluator --> GroundedAnswer
GroundedGenerationEvaluator --> GroundedEvaluationResult
GroundedGenerationEvaluator --> GroundedEvaluationReport
CliParser --> SubcommandCollection
CliEntrypoint --> CliParser
CliEntrypoint --> CliCommands
CliCommands --> LibraryService
CliCommands --> QuestionAnsweringService
CliCommands --> DocumentSummarizationService
CliCommands --> QuestionBankService
CliCommands --> LearningPackageService
CliCommands --> LearningPackageStudyService
CliCommands --> LearningProgressService
CliEntrypoint --> Doctor
CliEntrypoint --> ErrorReporting
CliCommands --> WebServer
WebServer --> WebApplication
WebApplication --> HomeTemplate
WebApplication --> LibraryDetailTemplate
WebApplication --> LibraryManagementTemplate
WebApplication --> PackageCreateTemplate
WebApplication --> PackageUploadValidatedTemplate
WebApplication --> ProgressTemplate
HomeTemplate --|> BaseTemplate
LibraryDetailTemplate --|> BaseTemplate
LibraryManagementTemplate --|> BaseTemplate
ProgressTemplate --|> BaseTemplate
PackageCreateTemplate --|> BaseTemplate
PackageUploadValidatedTemplate --|> BaseTemplate
WebApplication --> PackageCatalog
WebApplication --> SummaryCatalog
WebApplication --> QuestionCatalog
WebApplication --> PackageStudy
WebApplication --> ProgressReporting
WebApplication --> LibraryManagement
LearningPackageCatalog ..|> PackageCatalog
DocumentSummaryCatalog ..|> SummaryCatalog
QuestionBankCatalog ..|> QuestionCatalog
LearningPackageStudyService ..|> PackageStudy
LearningProgressService ..|> ProgressReporting
LocalLibraryManager ..|> PackageCatalog
LocalLibraryManager ..|> SummaryCatalog
LocalLibraryManager ..|> QuestionCatalog
LocalLibraryManager ..|> PackageStudy
LocalLibraryManager ..|> ProgressReporting
LocalLibraryManager ..|> LibraryManagement
WebServer --> LocalLibraryManager : compose
LocalLibraryManager *-- LearningPackageCatalog
LocalLibraryManager *-- DocumentSummaryCatalog
LocalLibraryManager *-- QuestionBankCatalog
LocalLibraryManager *-- LearningPackageStudyService
LocalLibraryManager *-- LearningProgressService
LearningPackageCatalog --> SqliteLearningPackageRepository

note bottom
  Interface registrars and entry points are functions or modules rather than
  classes; they are shown here because this view documents external runtime
  boundaries.
end note
@enduml
