  [ingestion]
  [chunking]
  [retrieval]
  [library]
}
package "[[diagrams/generation-summaries.svg Grounded generation]]" as Generation #FFF4D9 {
  [question answering]
  [summarization]
  [generation adapters]
}
package "[[diagrams/question-banks-packages.svg Learning material]]" as Material #F3E8FF {
  [question banks]
  [learning packages]
}
package "[[diagrams/study-progress.svg Study workflow]]" as Study #FFE8E8 {
  [answer evaluation]
  [study sessions]
  [review and progress]
}
package "[[diagrams/evaluation-interfaces.svg Quality and interfaces]]" as Interfaces #EFFFF4 {
