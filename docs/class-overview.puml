GenerationIdentity o-- "1..*" PromptReference
QuestionGenerationResult *-- "1..*" GeneratedQuestionDraft
QuestionGenerationResult o-- "1..*" PromptReference
CachedSummaryBatch *-- GenerationResult
PersistedDocumentSummary *-- "1..*" Citation
PersistedDocumentSummary o-- "1..*" PromptReference
ApplicationDocumentSummary *-- "1..*" Citation
ApplicationDocumentSummary o-- "0..*" PromptReference

HuggingFaceTextGenerator ..|> TextGenerator
HuggingFaceTextGenerator ..|> QuestionGenerator
